# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fan_sale_dev

# Auth — JWT secret shared with the core auth service
# Must match the secret used to sign the 'at' cookie in vivid-web-athena
AUTH_JWT_SECRET=change_me_in_production

# Feature flag — set to "true" to enable the Fan Sale API
# Backend counterpart to the Optimizely fanSaleEnabled flag in vivid-web-athena
# Both must be enabled for sellers to access the API
FAN_SALE_ENABLED=true

# Adyen for Platforms (Balance Platform)
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=VividSeatsECOM
ADYEN_BALANCE_PLATFORM=
ADYEN_WEBHOOK_HMAC_KEY=
ADYEN_ENVIRONMENT=TEST

# Internal service URLs
HERMES_SERVICE_URL=http://localhost:4000
